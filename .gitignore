# OS generated files (Windows & Linux Mint)
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.directory
.Trash-*

# Temporary & backup files
*.tmp
*.bak
*~
*.swp

# Godot 4+ specific ignores
.godot/
**/.godot/
.nomedia
build/
exports/
*.exe
*.pck
*.x86_64

# Obsidian volatile cache (ignore tab/window layout cache to avoid noisy diffs across PC & Laptop, but KEEP all core configs!)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# Explicitly track Obsidian core settings & appearance
!.obsidian/app.json
!.obsidian/appearance.json
!.obsidian/core-plugins.json
!.obsidian/graph.json
